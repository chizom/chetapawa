# Everything here is optional. With no .env at all, `npm run dev` runs in mock mode
# with a local data file (.data/local-db.json), so no accounts or keys are needed.

# Supabase. Leave blank to use the local store. Set all three for a real database plus realtime.
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# NEAR Intents 1Click API.
ONE_CLICK_API_BASE=https://1click.chaindefuser.com
# Optional partner JWT from https://partners.near-intents.org. Without it, 1Click adds a small fee to each quote.
ONE_CLICK_JWT=

# Blank: mock in development, real in production. true: always mock. false: always real.
MOCK_INTENTS=
# Mock mode is ignored when NODE_ENV=production unless this is also true (for a deliberate mock demo deploy).
MOCK_INTENTS_ALLOW_PRODUCTION=false

NUXT_PUBLIC_SITE_URL=http://localhost:3000
